# Harness Nexus server — environment configuration.
#
# Copy to `.env` and fill in. Mirrors packages/server/src/config.ts exactly;
# that file is the source of truth for defaults and parsing.
#
#   cp .env.example .env

# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Secret used to sign JWT access tokens. MUST be ≥16 characters or the server
# refuses to boot. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-16-chars

# ─── Strongly recommended ────────────────────────────────────────────────────
# Key material for AES-256-GCM encryption of Credential secrets at rest.
# If unset, falls back to JWT_SECRET (acceptable for single-instance dev, but
# rotating JWT_SECRET then re-encrypts nothing — set a dedicated key in prod).
#   openssl rand -base64 48
# CREDENTIAL_ENCRYPTION_KEY=

# ─── Server / network ────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info            # trace | debug | info | warn | error | fatal

# ─── Storage ─────────────────────────────────────────────────────────────────
# `sqlite` (default, persistent) or `memory` (ephemeral — wiped on restart).
STORAGE_DRIVER=sqlite
# Only used when STORAGE_DRIVER=sqlite. The image defaults these to /data/...;
# override here only if you mount storage somewhere else.
# DATA_DIR=/data
# SQLITE_PATH=/data/harnessnexus.sqlite

# ─── Auth ────────────────────────────────────────────────────────────────────
# JWT issuer claim (`iss`) and access-token lifetime (jose-compatible string).
JWT_ISSUER=harnessnexus
JWT_ACCESS_TTL=7d

# ─── Marketplace browse (Phase 7.2) — the server's only outbound fetch ───────
# Comma-separated `name=owner/repo` (→ GitHub raw) or `name=url` (verbatim).
MARKETPLACE_ALLOWLIST=claude-plugins-official=anthropics/claude-plugins-official
MARKETPLACE_FETCH_TTL_MS=3600000     # catalog cache TTL (ms), default 1h
MARKETPLACE_FETCH_TIMEOUT_MS=10000   # per-fetch timeout (ms), default 10s
# Test/fixture mode: read a local marketplace.json instead of HTTP. Leave unset
# in production.
# MARKETPLACE_FIXTURE_PATH=

# ─── Multi-source skill search (Phase 7.4) ───────────────────────────────────
# Optional GitHub PAT — raises GitHubSource rate limit from 60/hr to 5000/hr.
# GITHUB_TOKEN=
# Comma-separated owner/repo taps for GitHubSource. Defaults to the 4 trusted repos.
SKILL_GITHUB_TAPS=openai/skills,anthropics/skills,huggingface/skills,NVIDIA/skills
SKILL_SEARCH_TIMEOUT_MS=30000        # per-source timeout (ms), default 30s
# Comma-separated source ids to disable (test mode), e.g. github,well-known,url
# SKILL_DISABLED_SOURCES=
