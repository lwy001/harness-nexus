{
  "name": "@harness-nexus/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript client SDK for the Harness Nexus HTTP API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(lint placeholder) add eslint/oxlint config\"",
    "test": "echo \"(test placeholder) add vitest\""
  },
  "dependencies": {
    "@harness-nexus/core": "workspace:*",
    "@harness-nexus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.8.6",
    "typescript": "^5.6.3"
  }
}
